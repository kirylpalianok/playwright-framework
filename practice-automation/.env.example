# All settings below are optional. Unset settings fall back to safe defaults for the
# public practice target, so the framework runs with no .env file at all.
# See docs/operations/configuration.md for the full reference.

# Base URL of the public practice target under test. Must be an https URL.
BASE_URL=https://practice-automation.com

# Central timeout classes, in milliseconds. Uncomment only to prove a legitimately
# slower contract (see AGENTS.md section 10); do not raise these to mask flakiness.
#ACTION_TIMEOUT_MS=10000
#NAVIGATION_TIMEOUT_MS=15000
#EXPECT_TIMEOUT_MS=5000
#TEST_TIMEOUT_MS=30000
